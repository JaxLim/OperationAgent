{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/tooling",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["scripts/**/*.ts", "tests/p0/**/*.ts", "tests/p1/**/*.ts", "tests/p2/**/*.ts", "tests/m2/**/*.ts",
    "apps/desktop/src/renderer/markdown.ts", "apps/desktop/src/renderer/conversation.ts"],
  "references": [{ "path": "packages/contracts" }, { "path": "packages/worker-transport" }]
}
